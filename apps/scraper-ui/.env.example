# Zugang zur Supabase-Datenbank für den Knopf „In Datenbank laden“.
#
# 1. Diese Datei kopieren:   cp .env.example .env
# 2. Im Supabase-Dashboard oben auf „Connect“ klicken und die Verbindungsadresse
#    „Session pooler“ kopieren (beginnt mit postgresql://).
# 3. Die Adresse unten eintragen und [YOUR-PASSWORD] durch das Datenbank-Passwort
#    des Projekts ersetzen.
#
# Die Datei .env enthält damit ein Passwort mit Schreibrecht. Sie ist per
# .gitignore ausgeschlossen und darf nie eingecheckt oder weitergegeben werden.

SUPABASE_DB_URL=postgresql://postgres.npniuyzjgiksczpnvihp:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
