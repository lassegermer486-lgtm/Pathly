# Kopieren nach .env und Wert eintragen. .env wird nie committet.
OPENROUTER_API_KEY=
# Modell des Agent-Resolvers. Der Antwort-Cache (data/enriched/agent_cache.json)
# ist nach Modell geschlüsselt: Der Registerstand v1.3 wurde mit diesem Modell
# erzeugt. Ein anderes Modell findet die gespeicherten Antworten nicht und
# ändert damit das Ergebnis (Umbenennungen/Fusionen fehlen). Ohne Angabe gilt
# der Code-Standard openai/gpt-4o-mini.
OPENROUTER_MODEL=anthropic/claude-opus-5.5
